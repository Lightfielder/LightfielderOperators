  type="sphere"
Tool: create_camera
Tool: select_by_name
  name="Cube"
Tool: get_selected
Tool: set_transform
  id="obj_3"
  position=[2,0,0]
  rotation=[0,0,0]
  scale=[1,1,1]
Tool: rename_object
  id="obj_3"
  name="MyCube"
Tool: deselect_all
Tool: select_by_name
  name="MyCube"
Tool: duplicate_selected
Tool: frame_all
Tool: set_shading
  mode="wireframe"
Tool: show_grid
  on=false
Tool: open_outliner
Tool: open_attributes
